# Generated by Cargo / rustc
/target
**/target

# Backup / swap files
*.rs.bk
*.swp
.DS_Store

# Editor / IDE
.idea/
.vscode/*
!.vscode/settings.json

# Stray build/verify debug output (root-level _*.log, _verify*.log, and any
# bare *.log emitted by tool runs) and agent scratch directories generated
# during tool runs.
_*.log
_verify*.log
/*.log
_agent_*/

# Kilo internal state
.kilo/

# Local cargo config overrides (but keep the workspace xtask alias tracked)
.cargo/*
!.cargo/config.toml
